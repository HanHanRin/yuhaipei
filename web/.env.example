# AI 数字分身 · DeepSeek API（本地预览必填）
# ---------------------------------------------------------------
# 复制为 .env.local 后填入真实 key，然后 npm run dev
# 密钥只在服务端读取，绝不出现在前端或仓库里。
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：覆盖默认模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：覆盖默认 API base URL（如自建代理或其他 OpenAI 兼容端点）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 视觉模型 · Qwen-VL（DashScope）· 上传招聘 JD 图片做岗位匹配
# 没配也不影响文字对话，只是图片匹配会提示功能未开启
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-vl-max
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
